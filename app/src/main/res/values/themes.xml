<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Always-dark brand theme: black backdrop with a yellow accent.
         No DayNight switching on purpose. -->
    <style name="Base.Theme.PhotoFilter" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_yellow</item>
        <item name="colorSecondary">@color/accent_amber</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_muted</item>
        <item name="android:windowBackground">@color/bg_base</item>
        <item name="android:statusBarColor">@color/bg_base</item>
        <item name="android:navigationBarColor">@color/bg_base</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
    </style>

    <style name="Theme.PhotoFilter" parent="Base.Theme.PhotoFilter" />

    <style name="Text.Hero" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/sora_extrabold</item>
        <item name="fontFamily">@font/sora_extrabold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/sora_bold</item>
        <item name="fontFamily">@font/sora_bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="Text.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="ShapeAppearance.HAT.RoundedImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.HAT.FilterThumbnail" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">13dp</item>
    </style>

    <style name="ShapeAppearance.Home.RoundedHero" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.Home.RoundedThumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

</resources>
