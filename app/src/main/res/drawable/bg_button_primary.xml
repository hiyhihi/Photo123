<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface_alt" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="@color/accent_yellow"
                android:endColor="@color/accent_amber"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>
