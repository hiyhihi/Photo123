<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_backdrop"
    tools:context=".ui.MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/wordmarkText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/sora_extrabold"
            android:letterSpacing="0.04"
            android:text="@string/app_name"
            android:textColor="@color/accent_blue"
            android:textSize="22sp" />

    </com.google.android.material.appbar.MaterialToolbar>

    <FrameLayout
        android:id="@+id/imageContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/sheetContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/mainImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:background="@color/bg_surface"
            android:contentDescription="@string/content_desc_main_image"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.HAT.RoundedImage"
            app:strokeColor="@color/glass_stroke"
            app:strokeWidth="1dp" />

        <TextView
            android:id="@+id/emptyStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/inter_regular"
            android:text="@string/empty_state_message"
            android:textColor="@color/text_muted"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent_blue"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/sheetContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_sheet_top_rounded"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/filterRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            tools:listitem="@layout/item_filter_thumbnail" />

        <LinearLayout
            android:id="@+id/toolsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp">

            <Button
                android:id="@+id/rotateButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_ghost"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:enabled="false"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.01"
                android:paddingHorizontal="4dp"
                android:text="@string/action_rotate"
                android:textAllCaps="false"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:elevation="0dp" />

            <Button
                android:id="@+id/cropButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_ghost"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:enabled="false"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.01"
                android:paddingHorizontal="4dp"
                android:text="@string/action_crop"
                android:textAllCaps="false"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:elevation="0dp" />

            <Button
                android:id="@+id/adjustToggleButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_ghost"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:enabled="false"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.01"
                android:paddingHorizontal="4dp"
                android:text="@string/filter_adjust"
                android:textAllCaps="false"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:elevation="0dp" />

        </LinearLayout>

        <Button
            android:id="@+id/aiEnhanceButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:enabled="false"
            android:fontFamily="@font/inter_semibold"
            android:letterSpacing="0.01"
            android:text="@string/action_ai_enhance"
            android:textAllCaps="false"
            android:textColor="@color/text_on_accent"
            android:elevation="0dp" />

        <LinearLayout
            android:id="@+id/adjustPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="@string/adjust_brightness"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/brightnessSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="100"
                android:progressTint="@color/accent_blue"
                android:thumbTint="@color/accent_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="@string/adjust_contrast"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/contrastSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="100"
                android:progressTint="@color/accent_blue"
                android:thumbTint="@color/accent_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="@string/adjust_saturation"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/saturationSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="100"
                android:progressTint="@color/accent_blue"
                android:thumbTint="@color/accent_blue" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp">

            <Button
                android:id="@+id/pickImageButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_solid"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.01"
                android:text="@string/action_pick_image"
                android:textAllCaps="false"
                android:textColor="@color/text_on_accent"
                android:elevation="0dp" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:enabled="false"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.01"
                android:text="@string/action_save"
                android:textAllCaps="false"
                android:textColor="@color/text_on_accent"
                android:elevation="0dp" />

            <Button
                android:id="@+id/shareButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_ghost"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:enabled="false"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.01"
                android:text="@string/action_share"
                android:textAllCaps="false"
                android:textColor="@color/accent_blue"
                android:elevation="0dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
