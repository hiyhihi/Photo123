<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="80dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:duplicateParentState="true"
        android:background="@drawable/selector_filter_selected"
        android:padding="3dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/filterThumbnailImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_filter_thumbnail"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.HAT.FilterThumbnail" />

        <View
            android:id="@+id/favoriteBadge"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|end"
            android:layout_margin="3dp"
            android:background="@drawable/dot_accent"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/filterNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:duplicateParentState="true"
        android:fontFamily="@font/inter_medium"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/filter_name_text_color"
        android:textSize="11sp"
        android:textAlignment="center" />

</LinearLayout>
