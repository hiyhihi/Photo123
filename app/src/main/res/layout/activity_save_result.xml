<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_backdrop"
    tools:context=".ui.SaveResultActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/saveResultToolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/text_primary"
        app:title="@string/save_result_title"
        app:titleTextAppearance="@style/Text.SectionTitle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/saveResultImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="20dp"
        android:contentDescription="@string/content_desc_save_result_image"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toBottomOf="@id/saveResultToolbar"
        app:layout_constraintBottom_toTopOf="@id/shareResultButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/shareResultButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_button_primary"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:elevation="0dp"
        android:fontFamily="@font/inter_semibold"
        android:letterSpacing="0.01"
        android:text="@string/action_share"
        android:textAllCaps="false"
        android:textColor="@color/text_on_accent"
        app:layout_constraintBottom_toTopOf="@id/editMoreButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/editMoreButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_button_ghost"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:elevation="0dp"
        android:fontFamily="@font/inter_semibold"
        android:letterSpacing="0.01"
        android:text="@string/action_edit_more"
        android:textAllCaps="false"
        android:textColor="@color/accent_yellow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
